<?xml version="1.0" encoding="UTF-8"?>
<fomod>
  <Name>Main Menu Video Player</Name>
  <Author>SulfurNitride</Author>
  <Version>@PROJECT_VERSION@</Version>
  <Website>https://github.com/SulfurNitride/Fallout4-Main-Menu-Video-Player</Website>
  <Description>Play ordinary videos or native BK2/XWM pairs on Fallout 4's main menu, with optional independently randomized soundtracks. No ESP or ESL is required.</Description>
</fomod>
