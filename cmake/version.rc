        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Main Menu Video Player contributors"
            VALUE "FileDescription", "Fallout 4 Main Menu Video Player"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "MainMenuVideoPlayer"
            VALUE "OriginalFilename", "MainMenuVideoPlayer.dll"
            VALUE "ProductName", "Main Menu Video Player"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
