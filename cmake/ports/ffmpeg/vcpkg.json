{
  "name": "ffmpeg",
  "version": "9.0.1",
  "port-version": 1,
  "description": "FFmpeg multimedia libraries with zscale support",
  "homepage": "https://ffmpeg.org",
  "license": null,
  "dependencies": [
    {
      "name": "ffmpeg-bin2c",
      "host": true
    },
    {
      "name": "vcpkg-cmake-get-vars",
      "host": true
    },
    {
      "name": "vcpkg-pkgconfig-get-modules",
      "host": true
    }
  ],
  "features": {
    "avcodec": {
      "description": "Build the avcodec library"
    },
    "avfilter": {
      "description": "Build the avfilter library"
    },
    "avformat": {
      "description": "Build the avformat library",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": ["avcodec"]
        }
      ]
    },
    "swresample": {
      "description": "Build the swresample library"
    },
    "swscale": {
      "description": "Build the swscale library"
    },
    "zimg": {
      "description": "Enable the zscale filter through zimg",
      "dependencies": [
        "zimg",
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": ["avfilter"]
        }
      ]
    }
  }
}
